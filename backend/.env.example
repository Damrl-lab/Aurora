# Per-host overrides read by docker-compose.yml when you run `docker compose up`
# from this directory. Copy to `.env` and edit as needed. `.env` is gitignored.

# Host-side port for the public pipeline endpoint (POST /recommend).
# Default 8010. Change if that port is already taken on your host.
PIPELINE_API_PORT=8010

# Leave blank to allow the deepseek_llm service to use the GPU automatically
# via torch.cuda.is_available(). Set to "-1" on hosts where that check
# returns True but the GPU is actually unusable (common on shared Linux
# servers with an NVML stub but no real CUDA driver — torch thinks the
# GPU is there and bitsandbytes then crashes when it tries to allocate).
CUDA_VISIBLE_DEVICES=
